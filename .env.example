# Example environment variables
# Copy to .env or set in host dashboard

# Port the app listens on (platforms usually provide this)
PORT=5000

# Directory where models are stored (relative or absolute). Default is '.'
MODEL_DIR=.

# Enable API token auth (optional)
API_AUTH_ENABLED=False
API_TOKEN=changeme

# CORS settings (optional)
CORS_ENABLED=False
CORS_ORIGINS=*

# Gunicorn worker concurrency (optional)
WEB_CONCURRENCY=1
